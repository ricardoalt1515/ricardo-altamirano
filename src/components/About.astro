---
import { about, method } from "../data/content";
---

<section class="section about" id="about">
  <div class="container">
    <p class="marker" data-reveal>
      <span class="marker__num">01</span><span>About</span>
    </p>

    <div class="about__grid">
      <div class="about__intro">
        {about.intro.map((p, i) => (
          <p class="about__para" data-reveal style={`--reveal-delay:${i * 90}ms`}>{p}</p>
        ))}
      </div>

      <div class="about__beliefs">
        <p class="marker about__beliefs-marker" data-reveal>
          <span>What I believe</span>
        </p>
        <ul class="about__belief-list">
          {about.beliefs.map((b, i) => (
            <li class="about__belief" data-reveal style={`--reveal-delay:${i * 110}ms`}>{b}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="method">
      <p class="marker method__marker" data-reveal>
        <span>{method.label}</span>
      </p>
      <ul class="method__list">
        {method.principles.map((p, i) => (
          <li class="method__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="method__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="method__body">
              <span class="method__title">{p.title}</span>
              <span class="method__detail">{p.detail}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 900px) {
    .about__grid { grid-template-columns: 1.05fr 0.95fr; }
  }

  .about__para {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    line-height: 1.5;
    color: var(--ink);
    max-width: 30ch;
  }
  .about__para + .about__para { margin-top: 1.5rem; }
  .about__para:last-child { color: var(--ink-dim); }

  .about__beliefs-marker { margin-bottom: 2rem; }
  .about__beliefs-marker::before { background: var(--accent); }

  .about__belief-list {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .about__belief {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.45rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    border-bottom: 1px solid var(--line);
    position: relative;
    padding-left: 1.75rem;
  }
  .about__belief::before {
    content: "→";
    position: absolute;
    left: 0;
    top: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--accent);
    font-family: var(--font-mono);
  }

  /* ---- How I build reliable AI systems ---- */
  .method {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line-strong);
  }
  .method__marker { margin-bottom: clamp(2rem, 4vw, 2.75rem); }
  .method__marker::before { background: var(--accent); }

  .method__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .method__list { grid-template-columns: 1fr 1fr; column-gap: clamp(2rem, 5vw, 4rem); }
  }

  .method__item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.5vw, 1.5rem);
    border-bottom: 1px solid var(--line);
  }
  .method__num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent);
    flex: none;
    letter-spacing: 0.05em;
  }
  .method__body { display: block; }
  .method__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .method__detail {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-dim);
    max-width: 42ch;
  }
</style>
