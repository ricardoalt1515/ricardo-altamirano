---
import { projects } from "../data/content";
---

<section class="section section--light work" id="work">
  <div class="container">
    <p class="marker" data-reveal>
      <span class="marker__num">02</span><span>Selected Work</span>
    </p>
    <h2 class="section-title work__title" data-reveal>Systems<br />I've shipped</h2>
    <p class="lede work__lede" data-reveal>
      Production AI built inside real domain operations — not prototypes.
    </p>

    <ol class="work__list">
      {projects.map((p, i) => (
        <li class="work__item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <div class="work__num">{p.index}</div>
          <div class="work__body">
            <div class="work__head">
              <h3 class="work__name">{p.title}</h3>
              {p.status && <span class="work__status">{p.status}</span>}
            </div>
            <p class="work__blurb">{p.blurb}</p>
            {p.metric && (
              <p class="work__metric"><span>↗</span> {p.metric}</p>
            )}
            <ul class="work__tags">
              {p.tags.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .work__title { margin-bottom: 1.25rem; }
  .work__lede { margin-bottom: clamp(3rem, 7vw, 5rem); }

  .work__list {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .work__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding-block: clamp(2rem, 5vw, 3.25rem);
    border-bottom: 1px solid var(--line-strong);
    transition: padding-left 0.4s var(--ease);
  }
  @media (min-width: 760px) {
    .work__item {
      grid-template-columns: clamp(4rem, 9vw, 7rem) 1fr;
      gap: clamp(1.5rem, 4vw, 3rem);
    }
    .work__item:hover { padding-left: 0.75rem; }
  }

  .work__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-feature-settings: "tnum";
  }

  .work__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .work__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 1rem + 1.8vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 18ch;
  }
  .work__status {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .work__blurb {
    color: var(--ink-dim);
    max-width: 62ch;
  }

  .work__metric {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.45rem 0.85rem;
  }

  .work__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
</style>
