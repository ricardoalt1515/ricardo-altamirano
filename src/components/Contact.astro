---
import { contact, site } from "../data/content";
const year = new Date().getFullYear();
---

<section class="section contact" id="contact">
  <div class="container">
    <p class="marker" data-reveal>
      <span class="marker__num">06</span><span>Contact</span>
    </p>

    <h2 class="display contact__title" data-reveal>{contact.headline}</h2>
    <p class="lede contact__lede" data-reveal>{contact.lede}</p>

    <div class="contact__links" data-reveal>
      {contact.links.map((link) => (
        <a
          class="contact__link focus-ring"
          href={link.href}
          {...(link.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
        >
          <span>{link.label}</span>
          <span class="contact__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>

  <footer class="footer">
    <div class="container footer__inner">
      <span class="footer__name">{site.initials}</span>
      <span class="footer__meta">{site.location}</span>
      <span class="footer__meta">© <span id="footer-year">{year}</span> {site.name}</span>
    </div>
  </footer>
</section>

<script>
  // Keep the footer year current even if the site isn't rebuilt after Jan 1.
  const yearEl = document.getElementById("footer-year");
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>

<style>
  .contact { padding-bottom: 0; }

  .contact__title {
    font-size: clamp(2.6rem, 11vw, 8rem);
    color: var(--ink);
    margin-bottom: 2rem;
  }
  .contact__lede {
    max-width: 52ch;
    margin-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .contact__links {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
    max-width: 640px;
  }
  .contact__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(1.1rem, 3vw, 1.5rem);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 1rem + 2vw, 2.4rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: color 0.3s var(--ease), padding-left 0.4s var(--ease);
  }
  .contact__link:hover {
    color: var(--accent);
    padding-left: 0.75rem;
  }
  .contact__arrow {
    font-size: 0.55em;
    color: var(--ink-faint);
    transition: transform 0.3s var(--ease), color 0.3s var(--ease);
  }
  .contact__link:hover .contact__arrow {
    color: var(--accent);
    transform: translate(4px, -4px);
  }

  .footer {
    margin-top: clamp(5rem, 12vw, 9rem);
    border-top: 1px solid var(--line);
    padding-block: 2rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .footer__meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
